{
  "type": "record",
  "name": "Transaction",
  "namespace": "com.bootcamp.payments.transactions",
  "doc": "Transação financeira (PIX, crédito, débito ou boleto) — entidade de evento, append-only. Dados 100% sintéticos.",
  "fields": [
    {"name": "event_id", "type": "string", "doc": "UUID único por evento"},
    {
      "name": "event_time",
      "type": {"type": "long", "logicalType": "timestamp-millis"},
      "doc": "Quando o evento de negócio ocorreu (= created_at da transação)"
    },
    {"name": "transaction_id", "type": "string", "doc": "UUID da transação"},
    {"name": "account_id", "type": "string", "doc": "FK para Account"},
    {
      "name": "card_id",
      "type": ["null", "string"],
      "default": null,
      "doc": "FK para Card (null para PIX/boleto)"
    },
    {
      "name": "merchant_id",
      "type": ["null", "string"],
      "default": null,
      "doc": "FK para Merchant"
    },
    {
      "name": "channel",
      "type": {
        "type": "enum",
        "name": "Channel",
        "symbols": ["PIX", "CREDIT", "DEBIT", "BOLETO"]
      },
      "doc": "Canal de pagamento"
    },
    {
      "name": "amount",
      "type": {"type": "bytes", "logicalType": "decimal", "precision": 15, "scale": 2},
      "doc": "Valor em BRL — nunca float. Log-normal, mediana ~R$ 80",
      "confluent:tags": ["FIN"]
    },
    {
      "name": "mcc",
      "type": "string",
      "doc": "MCC do estabelecimento — 4 dígitos (ISO 18245)",
      "confluent:tags": ["FIN"]
    },
    {
      "name": "uf_transacao",
      "type": "string",
      "doc": "UF onde a transação ocorreu — correlaciona ≥85% com a UF de emissão do cartão",
      "confluent:tags": ["PII", "LGPD", "LOCATION"]
    },
    {
      "name": "status",
      "type": {
        "type": "enum",
        "name": "TransactionStatus",
        "symbols": ["CREATED", "AUTHORIZED", "SETTLED", "DECLINED", "REFUNDED"]
      },
      "default": "CREATED",
      "doc": "Ciclo de vida: CREATED → AUTHORIZED → SETTLED | DECLINED | REFUNDED"
    },
    {
      "name": "decline_reason",
      "type": [
        "null",
        {
          "type": "enum",
          "name": "DeclineReason",
          "symbols": ["INSUFFICIENT_FUNDS", "SUSPECTED_FRAUD", "EXPIRED_CARD", "LIMIT_EXCEEDED"]
        }
      ],
      "default": null,
      "doc": "Motivo da negação (null se não negada)"
    },
    {
      "name": "fraud_flag",
      "type": "boolean",
      "default": false,
      "doc": "Ground truth sintético de fraude (0.5–1.5% das transações) — para validar os labs de CEP/ML"
    },
    {
      "name": "fraud_rule",
      "type": [
        "null",
        {
          "type": "enum",
          "name": "FraudRule",
          "symbols": [
            "RULE_VELOCITY",
            "RULE_GEO_IMPOSSIBLE",
            "RULE_AMOUNT_OUTLIER",
            "RULE_NIGHT_OWL"
          ]
        }
      ],
      "default": null,
      "doc": "Padrão de fraude injetado (null se legítima)"
    },
    {
      "name": "created_at",
      "type": {"type": "long", "logicalType": "timestamp-millis"},
      "doc": "Quando o registro foi criado (created_at < authorized_at < settled_at)"
    },
    {
      "name": "authorized_at",
      "type": ["null", {"type": "long", "logicalType": "timestamp-millis"}],
      "default": null,
      "doc": "Quando foi autorizada (null se não autorizada)"
    },
    {
      "name": "settled_at",
      "type": ["null", {"type": "long", "logicalType": "timestamp-millis"}],
      "default": null,
      "doc": "Quando foi liquidada (null se não liquidada)"
    }
  ]
}
