{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "if": "Edit|Write(*.py)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/lint-python.sh",
            "timeout": 30,
            "statusMessage": "Linting Python file with ruff..."
          },
          {
            "type": "command",
            "if": "Edit|Write(*.py)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-check.sh",
            "timeout": 20,
            "statusMessage": "Checking format with Black..."
          },
          {
            "type": "command",
            "if": "Edit|Write(*.sql)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/validate-sql.sh",
            "timeout": 10,
            "statusMessage": "Validating SQL keywords..."
          },
          {
            "type": "command",
            "if": "Edit|Write(*.tf)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/terraform-fmt.sh",
            "timeout": 20,
            "statusMessage": "Formatting Terraform..."
          },
          {
            "type": "command",
            "if": "Edit|Write(*.tfvars)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/terraform-fmt.sh",
            "timeout": 20,
            "statusMessage": "Formatting Terraform vars..."
          },
          {
            "type": "command",
            "if": "Edit|Write(*.avsc)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/validate-avro-pii.sh",
            "timeout": 10,
            "statusMessage": "Validating Avro PII/PHI tags..."
          },
          {
            "type": "command",
            "if": "Edit|Write(*.avro)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/validate-avro-pii.sh",
            "timeout": 10,
            "statusMessage": "Validating Avro PII/PHI tags..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pre-commit-changelog.sh",
            "timeout": 10,
            "statusMessage": "Validating CHANGELOG entry..."
          }
        ]
      }
    ]
  }
}
