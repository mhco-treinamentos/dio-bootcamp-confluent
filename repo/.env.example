# Bootcamp Confluent Cloud 2026 — variáveis de ambiente
# Copie para .env e preencha. NUNCA commite o .env (está no .gitignore).

# Seletor de perfil: cloud (Confluent Cloud) | local (Docker fallback)
KAFKA_PROFILE=cloud

# === Confluent Cloud — Kafka cluster (Aula 0 / Curso 2) ===
CC_BOOTSTRAP=pkc-xxxxx.us-east1.gcp.confluent.cloud:9092
CC_API_KEY=
CC_API_SECRET=

# === Confluent Cloud — Schema Registry (Stream Governance) ===
SR_URL=https://psrc-xxxxx.us-east1.gcp.confluent.cloud
SR_API_KEY=
SR_API_SECRET=

# === Neon Postgres — o "banco legado" do bootcamp (Curso 3, Setup) ===
# Host/credenciais saem do dashboard do projeto Neon (bootcamp-dio).
PG_HOST=ep-xxxxx.us-east-1.aws.neon.tech
PG_PORT=5432
PG_DATABASE=payments
PG_USER=
PG_PASSWORD=

# Role dedicada do conector CDC (least privilege — criada no Setup do Curso 3)
PG_CDC_USER=cdc_user
PG_CDC_PASSWORD=
